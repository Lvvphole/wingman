{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wingman/governance/branch-protection-config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "target_branch", "ruleset_id", "active", "pull_request_required", "required_checks", "strict_currentness", "bypass", "force_push_denied", "deletion_denied", "review_policy", "candidate_head", "ci_evidence", "review_evidence", "merge_authorization"],
  "properties": {
    "repository": {"const": "Lvvphole/wingman"},
    "target_branch": {"type": "string", "minLength": 1, "pattern": "^(?!<).+"},
    "ruleset_id": {"type": ["string", "integer"]},
    "active": {"const": true},
    "pull_request_required": {"const": true},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "integration_id"], "properties": {"name": {"type": "string", "minLength": 1}, "integration_id": {"type": ["string", "integer"]}}}},
    "strict_currentness": {"const": true},
    "bypass": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["actor", "conditions"], "properties": {"actor": {"type": "string", "minLength": 1}, "conditions": {"type": "string", "minLength": 1}}}},
    "force_push_denied": {"const": true},
    "deletion_denied": {"const": true},
    "review_policy": {"type": "string", "minLength": 1},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ci_evidence": {"type": "string", "minLength": 1, "pattern": "^(?!<).+"},
    "review_evidence": {"type": "string", "minLength": 1, "pattern": "^(?!<).+"},
    "merge_authorization": {"const": "separate_user_action"}
  }
}
