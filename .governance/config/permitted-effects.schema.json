{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wingman/governance/permitted-effects/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["default_capabilities", "effects", "owner_approved"],
  "properties": {
    "default_capabilities": {"type": "array", "maxItems": 0},
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["PE-01", "PE-02", "PE-03", "PE-04", "PE-05", "PE-06", "PE-07", "PE-08", "PE-09", "PE-10"],
      "properties": {
        "PE-01": {"$ref": "#/$defs/effect"}, "PE-02": {"$ref": "#/$defs/effect"},
        "PE-03": {"$ref": "#/$defs/effect"}, "PE-04": {"$ref": "#/$defs/effect"},
        "PE-05": {"$ref": "#/$defs/effect"}, "PE-06": {"$ref": "#/$defs/effect"},
        "PE-07": {"$ref": "#/$defs/effect"}, "PE-08": {"$ref": "#/$defs/effect"},
        "PE-09": {"$ref": "#/$defs/effect"}, "PE-10": {"$ref": "#/$defs/effect"}
      }
    },
    "owner_approved": {"const": true}
  },
  "$defs": {
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "target_scope", "principal", "task_route_binding", "preconditions", "tool_capability", "expected_evidence", "stop_condition"],
      "properties": {
        "decision": {"enum": ["AUTHORIZED", "APPROVAL_GATED", "UNAUTHORIZED"]},
        "target_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "principal": {"type": "string", "minLength": 1},
        "task_route_binding": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "tool_capability": {"type": "string", "minLength": 1},
        "expected_evidence": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1}
      }
    }
  }
}
